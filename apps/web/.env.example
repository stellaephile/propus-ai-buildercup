# FastAPI agent base URL (live mode). Demo mode needs no backend.
NEXT_PUBLIC_API_URL=http://localhost:8010
# "demo" (default, recorded/fixture streams) or "live"
NEXT_PUBLIC_MODE=live

# Add to .env or .env.local



# --- Startup screen backdrop (optional) ---
# Drop a generated still or loop in apps/web/public/splash and point this at it.
# Unset = the built-in procedural field renders; the app ships fine with no asset.
# Must be abstract, non-cartographic art — see lib/tokens.ts splashTokens (§3.1/§12).
# NEXT_PUBLIC_SPLASH_BG=/splash/observatory.webm
# NEXT_PUBLIC_SPLASH_BG_POSTER=/splash/observatory.jpg
