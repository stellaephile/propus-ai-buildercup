# Propus environment — names only, no values (CLAUDE.md §10). Copy to .env.

# Supabase Postgres/PostGIS — owner connection (pipeline/loading only)
DATABASE_URL=

# Read-only, table-allowlisted, 5s-timeout role for the agent (db/roles.sql)
AGENT_DATABASE_URL=

# Gemini — advanced-tier queries only (scenario / multi-step reasoning)
GOOGLE_API_KEY=

# Groq — open-source models (Llama) for simple single-tool queries.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
